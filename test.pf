export readln() str;
export readi() int;
export streq(a str, b str) bool;
export println(s str);
export concat(a str, b str) str;
export printi(s value);






//
fibb(n int) int {
    if (n == 0) { return 0 }
    if (n == 1) { return 1 }

    fibb(n - 1) + fibb(n - 2)
}

factorial(n int) int {
    if (n == 0) { return 1 }
    if (n == 1) { return 1 }

    n * factorial(n-1)
}

tuple_test(x [[int, float], str]) {
    printi((x.0).0);
    printi((x.0).1);
    println(x.1);
}

export main() {
    let tuple [[int, float], str] = ((1, 2.0), "aa");

    tuple_test(tuple);

    println("Get factorial of:");
    let factorial_test = readi();
    printi(factorial(factorial_test));

    println("Get fibbonaci of:");
    let fibb_test = readi();
    printi(fibb(fibb_test));

    println("Do you like this program?");
    let result = readln();
    if (streq(result, "yes")) {
        println("OK. thank you");
    } else {
        println("Die");
    }
}
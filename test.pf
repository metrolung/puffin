export readln() str;
export readi() int;
export streq(a str, b str) bool;
export println(s str);
export concat(a str, b str) str;
export printi(s value);


fibb(n int) int {
    if (n == 0) { return 0 }
    if (n == 1) { return 1 }

    fibb(n - 1) + fibb(n - 2)
}

factorial(n int) int {
    if (n == 0) { return 1 }
    if (n == 1) { return 1 }

    n * factorial(n-1)
}


